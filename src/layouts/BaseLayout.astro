---
import '../styles/global.css';
import SpotlightNew from '../components/ui/SpotlightNew.astro';
import { TubesCursorBackground } from '../components/ui/tubes-cursor';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Ayush Saha is an AI Engineer and CS Student specializing in RAG architectures, autonomous multi-agent pipelines, LangGraph, Go, and high-performance vector databases."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#030406" />
    <link rel="canonical" href="https://ayushsaha.dev" />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://ayushsaha.dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://ayushsaha.dev/dp/ayush-saha-headshot.webp" />
    <meta property="og:site_name" content="Ayush Saha Portfolio" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://ayushsaha.dev/dp/ayush-saha-headshot.webp" />
    <meta name="twitter:creator" content="@AyushSaha184" />

    <title>{title}</title>
    <!-- Resource Hints & DNS Prefetching for CDN Latency Reduction -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">

    <!-- Non-render-blocking Web Font Loading -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap">
    </noscript>

    <!-- JSON-LD Structured Data for Search Engines -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Ayush Saha",
        "jobTitle": "AI Engineer & Computer Science Student",
        "url": "https://ayushsaha.dev",
        "image": "https://ayushsaha.dev/dp/ayush-saha-headshot.webp",
        "alumniOf": {
          "@type": "CollegeOrUniversity",
          "name": "Siliguri Institute of Technology"
        },
        "sameAs": [
          "https://github.com/AyushSaha184",
          "https://www.linkedin.com/in/AyushSaha184"
        ],
        "knowsAbout": [
          "Retrieval-Augmented Generation (RAG)",
          "Agentic AI",
          "LangGraph",
          "FastAPI",
          "Go",
          "Python",
          "Next.js",
          "Model Context Protocol (MCP)",
          "Vector Databases"
        ]
      }
    </script>
  </head>
  <body class="bg-[#030406] text-[#f3f4f6] font-sans antialiased overflow-x-hidden relative min-h-screen">
    <!-- Accessible Skip to Main Content Link -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[999] focus:px-4 focus:py-2.5 focus:bg-white focus:text-black focus:font-bold focus:rounded-xl focus:shadow-2xl focus:outline-none focus:ring-2 focus:ring-cyan-400"
    >
      Skip to main content
    </a>

    <!-- 3D Tubes Cursor Interactive Background (Click anywhere to randomize tube & light colors) -->
    <TubesCursorBackground client:load />

    <!-- Zero-JS Ambient Spotlight Background -->
    <SpotlightNew />

    <div class="relative z-10 pointer-events-none">
      <div class="pointer-events-auto">
        <slot />
      </div>
    </div>

    <script>
      import Lenis from 'lenis';

      (function() {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const isTouchDevice = 'ontouchstart' in window || window.matchMedia('(pointer: coarse)').matches;
        const isDesktop = window.innerWidth > 768;

        // Lenis Smooth Scroll initialized ONLY on desktop viewports to preserve native mobile momentum scrolling
        if (!reduced && isDesktop && !isTouchDevice) {
          const lenis = new Lenis({ smoothWheel: true });
          function raf(t: number) {
            lenis.raf(t);
            requestAnimationFrame(raf);
          }
          requestAnimationFrame(raf);
        }

        // Spotlight Navbar mousemove tracking - Throttled with RAF & disabled on touch devices
        if (!isTouchDevice) {
          let pointerRafPending = false;
          window.addEventListener('pointermove', (e) => {
            if (pointerRafPending) return;
            pointerRafPending = true;
            requestAnimationFrame(() => {
              pointerRafPending = false;
              const nav = document.querySelector('.spotlight-nav') as HTMLElement;
              if (nav) {
                const rect = nav.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                nav.style.setProperty('--mouse-x', `${x}px`);
                nav.style.setProperty('--mouse-y', `${y}px`);
              }
            });
          }, { passive: true });
        }

        // IntersectionObserver for Vengeance UI Flip Fade Text & scroll reveals
        const headings = document.querySelectorAll('.flip-fade-text');
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('active');
            } else {
              entry.target.classList.remove('active');
            }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

        headings.forEach(h => observer.observe(h));
      })();
    </script>
  </body>
</html>
