---
import '../styles/global.css';
import { SpotlightNew } from '../components/ui/spotlight-new';
import { PageLoader } from '../components/PageLoader';
import { TubesCursorBackground } from '../components/ui/tubes-cursor';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Ayush Saha | AI Engineer & Computer Science Student" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#030406" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Non-render-blocking Font Awesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" media="print" onload="this.media='all'" />
  </head>
  <body class="bg-[#030406] text-[#f3f4f6] font-sans antialiased overflow-x-hidden relative min-h-screen">
    <!-- Aceternity UI MultiStepLoader (Loading Screen) -->
    <PageLoader client:idle />

    <!-- 3D Tubes Cursor Interactive Background (Click anywhere to randomize tube & light colors) -->
    <TubesCursorBackground client:idle />

    <!-- Aceternity UI SpotlightNew Background (Ambient Multi-Cone Spotlight Beams) -->
    <SpotlightNew client:idle />

    <div class="relative z-10 pointer-events-none">
      <div class="pointer-events-auto">
        <slot />
      </div>
    </div>

    <script>
      import Lenis from 'lenis';

      (function() {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const isTouchDevice = 'ontouchstart' in window || window.matchMedia('(pointer: coarse)').matches;
        const isDesktop = window.innerWidth > 768;

        // Lenis Smooth Scroll initialized ONLY on desktop viewports to preserve native mobile momentum scrolling
        if (!reduced && isDesktop && !isTouchDevice) {
          const lenis = new Lenis({ smoothWheel: true });
          function raf(t: number) {
            lenis.raf(t);
            requestAnimationFrame(raf);
          }
          requestAnimationFrame(raf);
        }

        // Spotlight Navbar mousemove tracking - Throttled with RAF & disabled on touch devices
        if (!isTouchDevice) {
          let pointerRafPending = false;
          window.addEventListener('pointermove', (e) => {
            if (pointerRafPending) return;
            pointerRafPending = true;
            requestAnimationFrame(() => {
              pointerRafPending = false;
              const nav = document.querySelector('.spotlight-nav') as HTMLElement;
              if (nav) {
                const rect = nav.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                nav.style.setProperty('--mouse-x', `${x}px`);
                nav.style.setProperty('--mouse-y', `${y}px`);
              }
            });
          }, { passive: true });
        }

        // IntersectionObserver for Vengeance UI Flip Fade Text & scroll reveals
        const headings = document.querySelectorAll('.flip-fade-text');
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('active');
            } else {
              entry.target.classList.remove('active');
            }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

        headings.forEach(h => observer.observe(h));
      })();
    </script>
  </body>
</html>
