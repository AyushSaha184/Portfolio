---
import { FlipFadeText } from './ui/flip-fade-text';
import LineHoverLink from './ui/LineHoverLink.astro';
import GenerateButton from './ui/GenerateButton.astro';
import BorderBeam from './ui/BorderBeam.astro';

const projects = [
  { title: "PRism", tag: "GitHub App & Code Review AI", description: "A GitHub App and web platform that automates pull request reviews using four parallel AI specialists (Security, Code Quality, Tests, Docs) with hybrid code retrieval, evidence-backed findings, and human-in-the-loop approval queues.", techStack: ["Python", "FastAPI", "LangGraph", "Next.js", "Redis", "pgvector"], githubUrl: "https://github.com/AyushSaha184/PRism", repo: "PRism", year: "2025" },
  { title: "Eval_MCP", tag: "Model Context Protocol Engine", description: "A single-binary Model Context Protocol (MCP) server built natively in Go for prompt evaluation, RAG pipeline scoring, hallucination detection, regression tracking, and real-time dashboard analytics.", techStack: ["Go", "FastMCP", "Redis", "REST API", "Docker", "Render"], githubUrl: "https://github.com/AyushSaha184/Eval_MCP", repo: "Eval_MCP", year: "2025" },
  { title: "IntelliDocs", tag: "Enterprise RAG Knowledge System", description: "An enterprise-scale Retrieval-Augmented Generation (RAG) knowledge engine featuring multi-agent query orchestration, hybrid dense-sparse vector search (FAISS + BM25 + NVIDIA Reranking), streaming SSE, and session-isolated document indexing.", techStack: ["FastAPI", "LangChain", "Qdrant", "FAISS", "Redis", "Supabase"], demoUrl: "https://intelli-docs-five.vercel.app", githubUrl: "https://github.com/AyushSaha184/IntelliDocs", repo: "IntelliDocs", year: "2025" },
  { title: "booking-app", tag: "Full-Stack Reservation System", description: "A full-stack appointment and reservation scheduling platform built with Next.js 15, Drizzle ORM, Neon Serverless PostgreSQL, Upstash Redis rate limiting, Twilio SMS alerts, and Google Calendar API integration.", techStack: ["Next.js", "TypeScript", "Drizzle ORM", "Neon Postgres", "Upstash Redis", "Twilio API"], githubUrl: "https://github.com/AyushSaha184/booking-app", repo: "booking-app", year: "2025" },
  { title: "FiTrack", tag: "Mobile Fitness Tracker", description: "An all-in-one mobile fitness tracking application built with React Native, featuring MobX state management, Firebase authentication, MMKV local storage, and automated release builds.", techStack: ["React Native", "TypeScript", "MobX", "Firebase"], githubUrl: "https://github.com/AyushSaha184/FiTrack", repo: "FiTrack", year: "2025" },
  { title: "TestaCode", tag: "Agentic Test Generator", description: "An AI-powered test generation suite that accepts source files (Python, JS/TS, Java), parses AST/syntax structures, predicts intent, executes multi-stage LLM chains (analysis → generation → syntax validation → self-evaluation), and auto-corrects syntax errors.", techStack: ["Python", "FastAPI", "React", "TypeScript", "PostgreSQL"], demoUrl: "https://testa-code.vercel.app", githubUrl: "https://github.com/AyushSaha184/TestaCode", repo: "TestaCode", year: "2025" },
];

const projectsHeadings = [
  "SELECTED WORK & AI SYSTEMS",
  "AUTONOMOUS MULTI-AGENT TOOLS",
  "PRODUCTION READY CODEBASES"
];
---

<!-- Vengeance UI Projects Section with Stable Cards & Flip Fade Text -->
<section id="projects" class="relative py-20 sm:py-36 px-4 sm:px-8 bg-transparent overflow-hidden border-t border-white/10" aria-labelledby="projects-heading">
  <div class="shell">
    <div class="flex flex-col items-center text-center mb-8 sm:mb-12">
      <!-- Heading in Solid Clean White with semantic h2 -->
      <h2 id="projects-heading" class="sr-only">Selected Work & AI Systems</h2>
      <FlipFadeText
        client:visible
        words={projectsHeadings}
        interval={3500}
        letterDuration={0.5}
        staggerDelay={0.04}
        className="justify-center text-center min-h-[80px] sm:min-h-[100px]"
        textClassName="text-2xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white max-w-4xl"
      />
    </div>

    <!-- Stage with Stable Project Cards -->
    <div class="perspective-stage">
      {projects.map((p, idx) => (
        <div
          class="perspective-card p-card-item p-4 sm:p-8 md:p-11 text-white"
          data-index={idx}
          style="width: min(52rem, 92vw);"
        >
          <!-- 2 White Animated Border Beams (rendered only on the active card via JS) -->
          <div class="p-beam-host" data-beam-host="0" hidden>
            <BorderBeam size={360} duration={7} delay={0} colorFrom="#ffffff" colorTo="rgba(255,255,255,0)" borderWidth={1.5} />
          </div>
          <div class="p-beam-host" data-beam-host="1" hidden>
            <BorderBeam size={360} duration={7} delay={3.5} colorFrom="#ffffff" colorTo="rgba(255,255,255,0)" borderWidth={1.5} />
          </div>

          <div class="flex items-center justify-between pb-2.5 sm:pb-4 border-b border-white/10 text-xs sm:text-sm text-white/60">
            <LineHoverLink variant="slide" asSpan className="text-white font-semibold">
              {p.tag}
            </LineHoverLink>
          </div>

          <div class="py-3 sm:py-6">
            <h3 class="font-extrabold text-xl sm:text-4xl md:text-5xl text-white tracking-tight mb-2 sm:mb-4">
              {p.title}
            </h3>
            <p class="text-xs sm:text-base md:text-lg text-white/85 leading-relaxed font-normal mb-4 sm:mb-8">
              {p.description}
            </p>

            <div class="flex flex-wrap gap-1.5 sm:gap-2.5 mb-4 sm:mb-8">
              {p.techStack.map((tech) => (
                <LineHoverLink variant="slide" asSpan className="px-2 sm:px-3.5 py-1 text-[10px] sm:text-sm font-medium rounded-xl bg-white/10 border border-white/20 text-white/95">
                  {tech}
                </LineHoverLink>
              ))}
            </div>

            <!-- GitHub Stats & Generate Buttons -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4 pt-3 sm:pt-5 border-t border-white/10">
              <div class="flex items-center gap-4 sm:gap-5 text-xs sm:text-sm text-white/70 font-medium">
                <span>Stars: <span class="gh-stars text-white font-bold" data-repo={p.repo}>-</span></span>
                <span>Forks: <span class="gh-forks text-white font-bold" data-repo={p.repo}>-</span></span>
              </div>

              <!-- Vengeance UI Generate Buttons for Live Demo & GitHub -->
              <div class="flex items-center gap-2 sm:gap-3">
                {p.demoUrl && (
                  <GenerateButton
                    href={p.demoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`View live demo for ${p.title}`}
                  >
                    Live Demo
                  </GenerateButton>
                )}
                <GenerateButton
                  href={p.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`View GitHub repository for ${p.title}`}
                >
                  GitHub
                </GenerateButton>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Controls using Vengeance UI Generate Buttons -->
    <div class="flex items-center justify-center gap-4 mt-8 sm:mt-12">
      <GenerateButton id="p-prev" aria-label="Previous Project">
        PREV PROJECT
      </GenerateButton>
      <span class="text-xs text-white/60 font-medium px-2" id="p-indicator">1 / 6</span>
      <GenerateButton id="p-next" aria-label="Next Project">
        NEXT PROJECT
      </GenerateButton>
    </div>
  </div>
</section>

<script>
  (function() {
    const cards = Array.from(document.querySelectorAll('.p-card-item')) as HTMLElement[];
    const prevBtn = document.getElementById('p-prev');
    const nextBtn = document.getElementById('p-next');
    const indicator = document.getElementById('p-indicator');
    const projectsSection = document.getElementById('projects');

    let current = 0;
    const total = cards.length;

    // Single pair of BorderBeam hosts — moved into the active card to avoid
    // 12 simultaneous SVG animations (2 beams × 6 cards).
    const beamHosts = Array.from(document.querySelectorAll('[data-beam-host]')) as HTMLElement[];
    function attachBeamsTo(card: HTMLElement) {
      if (!card) return;
      beamHosts.forEach((host) => {
        if (host.parentElement !== card) card.appendChild(host);
        host.hidden = false;
      });
    }

    let pendingFrame = 0;
    function updatePerspective() {
      if (pendingFrame) return;
      pendingFrame = requestAnimationFrame(() => {
        pendingFrame = 0;
        const isMobile = window.innerWidth < 768;

        cards.forEach((card, i) => {
          const offset = i - current;
          const absOffset = Math.abs(offset);
          const isCurrent = offset === 0;

          card.setAttribute('aria-hidden', isCurrent ? 'false' : 'true');
          if (isCurrent) {
            card.removeAttribute('inert');
          } else {
            card.setAttribute('inert', '');
          }

          if (isCurrent) {
            card.style.transform = 'translateX(0) translateZ(0) rotateY(0deg) scale(1)';
            card.style.opacity = '1';
            card.style.zIndex = '30';
            card.style.pointerEvents = 'auto';
            card.style.visibility = 'visible';
            attachBeamsTo(card);
          } else if (isMobile) {
            const translateXVal = offset * (window.innerWidth * 0.95 + 16);
            card.style.transform = `translateX(${translateXVal}px) translateZ(0px) scale(1)`;
            card.style.opacity = '0.5';
            card.style.zIndex = '10';
            card.style.pointerEvents = 'none';
            card.style.visibility = absOffset <= 1 ? 'visible' : 'hidden';
          } else {
            const translateXVal = offset * 140;
            const rotateYVal = offset > 0 ? -12 : 12;
            card.style.transform = `translateX(${translateXVal}px) translateZ(-${absOffset * 180}px) rotateY(${rotateYVal}deg) scale(${1 - absOffset * 0.1})`;
            card.style.opacity = `${Math.max(0.15, 1 - absOffset * 0.35)}`;
            card.style.zIndex = `${30 - absOffset}`;
            card.style.pointerEvents = 'none';
            card.style.visibility = 'visible';
          }
        });

        if (indicator) indicator.textContent = `${current + 1} / ${total}`;
      });
    }

    function go(delta: number) {
      current = (current + delta + total) % total;
      updatePerspective();
    }

    prevBtn?.addEventListener('click', () => go(-1));
    nextBtn?.addEventListener('click', () => go(1));

    const stage = document.querySelector('#projects .perspective-stage');
    let touchStartX = 0;
    let touchEndX = 0;

    stage?.addEventListener('touchstart', (e: any) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    stage?.addEventListener('touchend', (e: any) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchEndX - touchStartX;
      if (Math.abs(diff) > 40) {
        go(diff < 0 ? 1 : -1);
      }
    }, { passive: true });

    let resizeFrame = 0;
    window.addEventListener('resize', () => {
      if (resizeFrame) return;
      resizeFrame = requestAnimationFrame(() => {
        resizeFrame = 0;
        updatePerspective();
      });
    });

    document.addEventListener('keydown', (e) => {
      if (document.activeElement?.tagName === 'INPUT' || document.activeElement?.tagName === 'TEXTAREA') return;
      const rect = stage?.getBoundingClientRect();
      const isFocusedInside = stage?.contains(document.activeElement) || prevBtn?.contains(document.activeElement) || nextBtn?.contains(document.activeElement);
      const isDominantlyVisible = rect && rect.top <= window.innerHeight * 0.4 && rect.bottom >= window.innerHeight * 0.6;
      if (isFocusedInside || isDominantlyVisible) {
        if (e.key === 'ArrowLeft') go(-1);
        if (e.key === 'ArrowRight') go(1);
      }
    });

    // IntersectionObserver: drop will-change when offscreen to free GPU memory.
    if ('IntersectionObserver' in window && projectsSection) {
      const obs = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) {
          cards.forEach(c => c.style.willChange = 'transform, opacity');
        } else {
          cards.forEach(c => c.style.willChange = 'auto');
        }
      }, { threshold: 0.1 });
      obs.observe(projectsSection);
    } else {
      cards.forEach(c => c.style.willChange = 'transform, opacity');
    }

    attachBeamsTo(cards[0]);
    updatePerspective();

    // Live GitHub Stats Fetcher (Concurrent with Promise.allSettled)
    const GH_CACHE_KEY = 'portfolio_gh_cache';
    const GH_TTL = 3600000;

    async function fetchGitHubStats() {
      const stars = document.querySelectorAll('.gh-stars');
      const repos = [...new Set([...stars].map(el => el.getAttribute('data-repo')).filter(Boolean))];
      if (!repos.length) return;

      const now = Date.now();
      let cache;
      try { cache = JSON.parse(localStorage.getItem(GH_CACHE_KEY) || ''); } catch {}
      const cachedData = cache?.data || {};

      repos.forEach(r => {
        if (!cachedData[r]) return;
        document.querySelectorAll(`.gh-stars[data-repo="${r}"]`).forEach(el => el.textContent = cachedData[r].stars);
        document.querySelectorAll(`.gh-forks[data-repo="${r}"]`).forEach(el => el.textContent = cachedData[r].forks);
      });

      if (cache && (now - cache.ts < GH_TTL)) return;

      const fetched: Record<string, { stars: string | number, forks: string | number }> = {};
      const fetchPromises = repos.map(async (repo) => {
        try {
          const res = await fetch(`https://api.github.com/repos/AyushSaha184/${repo}`);
          if (!res.ok) {
            if (cachedData[repo]) fetched[repo] = cachedData[repo];
            return;
          }
          const json = await res.json();
          const entry = { stars: json.stargazers_count ?? '-', forks: json.forks_count ?? '-' };
          fetched[repo] = entry;
          document.querySelectorAll(`.gh-stars[data-repo="${repo}"]`).forEach(el => el.textContent = String(entry.stars));
          document.querySelectorAll(`.gh-forks[data-repo="${repo}"]`).forEach(el => el.textContent = String(entry.forks));
        } catch {
          if (cachedData[repo]) fetched[repo] = cachedData[repo];
        }
      });

      await Promise.allSettled(fetchPromises);

      if (Object.keys(fetched).length) {
        try { localStorage.setItem(GH_CACHE_KEY, JSON.stringify({ ts: now, data: { ...cachedData, ...fetched } })); } catch {}
      }
    }

    if (typeof window !== 'undefined') {
      if ('requestIdleCallback' in window) {
        requestIdleCallback(() => fetchGitHubStats());
      } else {
        setTimeout(fetchGitHubStats, 1200);
      }
    }
  })();
</script>
