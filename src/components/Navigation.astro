---
import { LineHoverLink } from './ui/line-hover-link';
import { BorderBeam } from './ui/border-beam';

const navItems = [
  { label: 'Home', href: '#home' },
  { label: 'Skills', href: '#skills' },
  { label: 'Projects', href: '#projects' },
  { label: 'Resume', href: '#resume' },
  { label: 'Contact', href: '#contact' },
];
---

<!-- Vengeance UI Spotlight Navbar with Responsive 3-Line Mobile Dropdown -->
<header class="spotlight-nav-wrap flex items-center justify-between gap-2.5">
  <!-- Desktop / Tablet Main Nav Pill (Hidden on small mobile screens < 768px) -->
  <div class="spotlight-nav hidden md:flex items-center justify-between gap-4 flex-1 relative overflow-hidden">
    <!-- Left: Brand "Ayush Saha" with LineHoverLink slide -->
    <LineHoverLink
      client:idle
      href="#home"
      variant="slide"
      className="flex items-center gap-2 text-white font-bold tracking-tight text-sm shrink-0 hover:text-white transition-colors relative z-20"
    >
      <span class="font-bold text-sm tracking-wide text-white">Ayush Saha</span>
    </LineHoverLink>

    <!-- Center Nav: Line Hover Links -->
    <nav class="flex items-center gap-4 lg:gap-6 overflow-x-auto no-scrollbar py-1 relative z-20">
      {navItems.map((item) => (
        <LineHoverLink
          client:idle
          href={item.href}
          variant="slide"
          className="text-xs sm:text-sm text-white/80 hover:text-white font-medium transition-colors"
        >
          {item.label}
        </LineHoverLink>
      ))}
    </nav>

    <!-- Right: Social Symbols (GitHub & LinkedIn SVG Icons) -->
    <div class="flex items-center gap-3 shrink-0 relative z-20">
      <LineHoverLink
        client:idle
        href="https://github.com/AyushSaha184"
        target="_blank"
        rel="noopener noreferrer"
        variant="slide"
        aria-label="GitHub Profile"
        title="GitHub"
        className="text-white/80 hover:text-white p-1 transition-colors flex items-center justify-center"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 sm:w-5 sm:h-5 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
      </LineHoverLink>

      <LineHoverLink
        client:idle
        href="https://www.linkedin.com/in/AyushSaha184"
        target="_blank"
        rel="noopener noreferrer"
        variant="slide"
        aria-label="LinkedIn Profile"
        title="LinkedIn"
        className="text-white/80 hover:text-white p-1 transition-colors flex items-center justify-center"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 sm:w-5 sm:h-5 fill-current" viewBox="0 0 24 24">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.72a1.47 1.47 0 1 0 0 2.94 1.47 1.47 0 0 0 0-2.94Z"/>
        </svg>
      </LineHoverLink>
    </div>
  </div>

  <!-- Mobile Top Bar Pill (Visible on < 768px viewports) -->
  <div class="spotlight-nav flex md:hidden items-center justify-between gap-2 flex-1 relative overflow-hidden px-4 py-2.5">
    <a href="#home" class="font-bold text-xs sm:text-sm tracking-wide text-white shrink-0">
      Ayush Saha
    </a>

    <!-- 3-Line Hamburger Dropdown Toggle Button -->
    <button
      id="mobile-menu-toggle"
      type="button"
      aria-label="Toggle navigation menu"
      class="p-1.5 rounded-xl border border-white/20 bg-white/10 text-white hover:bg-white/20 transition-all flex items-center justify-center cursor-pointer"
    >
      <svg id="hamburger-icon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Search with AI Trigger Button -->
  <button
    id="ai-search-trigger"
    type="button"
    class="spotlight-nav-btn flex items-center gap-1.5 sm:gap-2 px-3.5 sm:px-4 py-2 sm:py-2.5 text-white text-xs sm:text-sm font-semibold shrink-0 overflow-hidden group cursor-pointer"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-white/80 group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <span class="relative z-20 tracking-wide text-white font-medium">Search with AI</span>
  </button>

  <!-- Mobile Dropdown Menu Overlay with Glowing Double Border Beams -->
  <div
    id="mobile-drawer"
    class="fixed inset-x-4 top-20 z-50 hidden flex-col gap-5 p-6 rounded-3xl bg-[#090b10]/95 border border-white/20 backdrop-blur-2xl shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-200"
  >
    <!-- DOUBLE BORDER BEAM EFFECT FOR MOBILE MENU -->
    <BorderBeam client:idle size={300} duration={6} delay={0} colorFrom="#ffffff" colorTo="rgba(255,255,255,0)" borderWidth={1.5} rx={24} />
    <BorderBeam client:idle size={300} duration={6} delay={3} colorFrom="#ffffff" colorTo="rgba(255,255,255,0)" borderWidth={1.5} rx={24} />

    <nav class="flex flex-col gap-4 text-left relative z-20">
      {navItems.map((item) => (
        <LineHoverLink
          client:idle
          href={item.href}
          variant="slide"
          className="mobile-nav-link text-base text-white font-semibold py-1"
        >
          {item.label}
        </LineHoverLink>
      ))}
    </nav>

    <div class="pt-4 border-t border-white/10 flex items-center justify-end relative z-20">
      <div class="flex items-center gap-4">
        <LineHoverLink
          client:idle
          href="https://github.com/AyushSaha184"
          target="_blank"
          rel="noopener noreferrer"
          variant="slide"
          aria-label="GitHub Profile"
          title="GitHub"
          className="mobile-nav-link text-white/80 hover:text-white p-1"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
        </LineHoverLink>

        <LineHoverLink
          client:idle
          href="https://www.linkedin.com/in/AyushSaha184"
          target="_blank"
          rel="noopener noreferrer"
          variant="slide"
          aria-label="LinkedIn Profile"
          title="LinkedIn"
          className="mobile-nav-link text-white/80 hover:text-white p-1"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.72a1.47 1.47 0 1 0 0 2.94 1.47 1.47 0 0 0 0-2.94Z"/>
          </svg>
        </LineHoverLink>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile Menu Drawer Toggle Handling
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-drawer');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (toggleBtn && drawer && hamburgerIcon && closeIcon) {
    const toggleMenu = () => {
      const isOpen = !drawer.classList.contains('hidden');
      if (isOpen) {
        drawer.classList.add('hidden');
        drawer.classList.remove('flex');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      } else {
        drawer.classList.remove('hidden');
        drawer.classList.add('flex');
        hamburgerIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
      }
    };

    toggleBtn.addEventListener('click', toggleMenu);

    const links = drawer.querySelectorAll('.mobile-nav-link, a');
    links.forEach((link) => {
      link.addEventListener('click', () => {
        drawer.classList.add('hidden');
        drawer.classList.remove('flex');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });
  }
</script>
