---
import { LineHoverLink } from './ui/line-hover-link';

const navItems = [
  { label: 'Home', href: '#home', variant: 'slide' },
  { label: 'Skills', href: '#skills', variant: 'slide' },
  { label: 'Projects', href: '#projects', variant: 'slide' },
  { label: 'Resume', href: '#resume', variant: 'slide' },
  { label: 'Contact', href: '#contact', variant: 'slide' },
];

const socials = [
  { url: "https://github.com/AyushSaha184", label: "GitHub" },
  { url: "https://www.linkedin.com/in/AyushSaha184", label: "LinkedIn" },
];
---

<!-- Vengeance UI Spotlight Navbar with Search Button outside -->
<header class="spotlight-nav-wrap flex items-center justify-between gap-3">
  <!-- Center Main Nav Pill -->
  <div class="spotlight-nav flex items-center justify-between gap-4 flex-1 relative overflow-hidden">
    <!-- Left: Brand "Ayush Saha" -->
    <a href="#home" class="flex items-center gap-2 text-white font-bold tracking-tight text-sm shrink-0 hover:text-white transition-colors relative z-20">
      <span class="font-bold text-sm tracking-wide text-white">Ayush Saha</span>
    </a>

    <!-- Center Nav: Line Hover Links -->
    <nav class="flex items-center gap-3 sm:gap-5 overflow-x-auto no-scrollbar py-1 relative z-20">
      {navItems.map((item) => (
        <LineHoverLink
          client:load
          href={item.href}
          variant="slide"
          className="text-xs sm:text-sm text-white/80 hover:text-white"
        >
          {item.label}
        </LineHoverLink>
      ))}
    </nav>

    <!-- Right: Socials -->
    <div class="flex items-center gap-3 shrink-0 relative z-20">
      {socials.map((s) => (
        <LineHoverLink
          client:load
          href={s.url}
          target="_blank"
          variant="slide"
          className="text-xs sm:text-sm text-white/70 hover:text-white"
        >
          {s.label}
        </LineHoverLink>
      ))}
    </div>
  </div>

  <!-- Right Side Outside Navbar: Search with AI Button -->
  <button
    id="ai-search-trigger"
    type="button"
    class="relative flex items-center gap-2 px-4 py-2.5 rounded-full bg-[#090b10]/90 backdrop-blur-xl border border-white/15 text-white text-xs sm:text-sm font-semibold hover:bg-white/15 hover:border-white/30 transition-all shadow-xl shrink-0 overflow-hidden group cursor-pointer"
  >
    <span class="relative z-20 tracking-wide text-white font-medium">Search with AI</span>
  </button>
</header>
