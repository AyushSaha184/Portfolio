---
import { FlipFadeText } from './ui/flip-fade-text';
import GenerateButton from './ui/GenerateButton.astro';
import BorderBeam from './ui/BorderBeam.astro';

const RESUME_PDF_URL = "/Resume.pdf";
const GITHUB_RESUME_URL = "https://github.com/AyushSaha184/Resume/releases/download/latestt/Resume.pdf";

const resumeHeadings = [
  "PROFESSIONAL RESUME",
  "ACADEMIC & TECHNICAL RECORD",
  "VERIFIED CANDIDATE PROFILE"
];
---

<!-- Vengeance UI Resume Section (Single Universal PDF Resume Viewer for Mobile & Desktop) -->
<section id="resume" class="relative py-20 sm:py-36 px-4 sm:px-8 bg-transparent border-t border-white/10" aria-labelledby="resume-heading">
  <div class="shell">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-8 sm:mb-14">
      <div>
        <!-- Vengeance UI Flip Fade Text Heading with semantic h2 -->
        <h2 id="resume-heading" class="sr-only">Professional Resume</h2>
        <FlipFadeText
          client:visible
          words={resumeHeadings}
          interval={3500}
          letterDuration={0.5}
          staggerDelay={0.04}
          className="justify-start text-left min-h-[70px] sm:min-h-[90px]"
          textClassName="text-2xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white max-w-3xl"
        />
      </div>

      <!-- Download Resume PDF Button -->
      <GenerateButton
        href={GITHUB_RESUME_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Download Ayush Saha Resume (PDF)"
      >
        Download Resume (PDF)
      </GenerateButton>
    </div>

    <!-- Single Universal PDF Document Panel (Renders on Mobile, Tablet & Desktop) -->
    <div class="relative rounded-3xl bg-[#090b10] p-4 sm:p-7 text-white shadow-2xl overflow-hidden border border-white/15">
      <!-- 2 White Animated Border Beams -->
      <BorderBeam size={360} duration={8} delay={0} colorFrom="#ffffff" colorTo="rgba(255,255,255,0)" borderWidth={1.5} />
      <BorderBeam size={360} duration={8} delay={4} colorFrom="#ffffff" colorTo="rgba(255,255,255,0)" borderWidth={1.5} />

      <!-- Top Header Bar -->
      <div class="flex items-center justify-between pb-4 mb-4 border-b border-white/10 text-xs sm:text-sm text-white/70">
        <div class="flex items-center gap-3">
          <span class="font-bold text-white text-sm sm:text-base">Resume.pdf</span>
        </div>
      </div>

      <!-- Actual PDF Document Viewer (responsive: native embed on desktop, Google Docs on most mobile, pdf.js for Firefox) -->
      <div class="relative w-full rounded-2xl overflow-hidden bg-[#030406] border border-white/10">
        <!-- Mobile + tablet: Google Docs viewer (works on iOS Safari & Android Chrome where native PDF embed fails) -->
        <iframe
          id="resume-gdocs"
          src={`https://docs.google.com/viewer?url=${encodeURIComponent(new URL(RESUME_PDF_URL, Astro.site ?? Astro.url.origin).toString())}&embedded=true`}
          class="w-full h-[550px] sm:h-[750px] md:h-[950px] rounded-2xl border-none block md:hidden"
          title="Ayush Saha Resume PDF"
          loading="lazy"
        ></iframe>

        <!-- pdf.js fallback container (hidden by default, shown by JS for Firefox or if Google Docs fails) -->
        <div
          id="resume-pdfjs"
          class="w-full h-[550px] sm:h-[750px] md:h-[950px] hidden overflow-auto bg-[#1a1a1a]"
          aria-label="Ayush Saha Resume PDF (pdf.js viewer)"
        ></div>

        <!-- Desktop: native object/iframe embed (full quality, no third-party hop) -->
        <object
          data={RESUME_PDF_URL}
          type="application/pdf"
          class="w-full h-[550px] sm:h-[750px] md:h-[950px] rounded-2xl border-none hidden md:block"
        >
          <iframe
            src={`${RESUME_PDF_URL}#toolbar=0&navpanes=0`}
            class="w-full h-[550px] sm:h-[750px] md:h-[950px] rounded-2xl border-none"
            title="Ayush Saha Resume PDF"
          >
            <div class="flex flex-col items-center justify-center p-10 text-center">
              <p class="text-sm text-white/80 mb-4">Preview not supported directly on this browser version.</p>
              <GenerateButton href={GITHUB_RESUME_URL} target="_blank" rel="noopener noreferrer">
                View Resume PDF
              </GenerateButton>
            </div>
          </iframe>
        </object>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const PDFJS_VERSION = '4.0.379';
    const PDFJS_CDN = `https://cdnjs.cloudflare.com/ajax/libs/pdf.js/${PDFJS_VERSION}/pdf.min.mjs`;
    const PDFJS_WORKER = `https://cdnjs.cloudflare.com/ajax/libs/pdf.js/${PDFJS_VERSION}/pdf.worker.min.mjs`;
    const RESUME_URL = '/Resume.pdf';

    const gdocs = document.getElementById('resume-gdocs');
    const pdfjsBox = document.getElementById('resume-pdfjs');
    if (!pdfjsBox) return;

    const isFirefox = /firefox|fxios/i.test(navigator.userAgent);

    function showPdfJs() {
      if (!gdocs) return;
      gdocs.style.display = 'none';
      pdfjsBox.classList.remove('hidden');
      pdfjsBox.classList.add('block');
    }

    async function loadPdfJs() {
      try {
        const lib = await import(PDFJS_CDN);
        const pdfjsLib = lib.GlobalWorkerOptions
          ? lib
          : lib.default || lib;
        pdfjsLib.GlobalWorkerOptions.workerSrc = PDFJS_WORKER;

        const loadingTask = pdfjsLib.getDocument(RESUME_URL);
        const pdf = await loadingTask.promise;

        const total = Math.min(pdf.numPages, 5);
        for (let i = 1; i <= total; i++) {
          const page = await pdf.getPage(i);
          const containerWidth = pdfjsBox.clientWidth - 16;
          const baseViewport = page.getViewport({ scale: 1 });
          const scale = Math.max(0.6, Math.min(1.5, containerWidth / baseViewport.width));
          const viewport = page.getViewport({ scale });

          const canvas = document.createElement('canvas');
          canvas.className = 'mx-auto my-2 rounded shadow-lg bg-white';
          canvas.style.display = 'block';
          canvas.style.width = viewport.width + 'px';
          canvas.style.height = viewport.height + 'px';
          canvas.width = viewport.width;
          canvas.height = viewport.height;
          pdfjsBox.appendChild(canvas);

          const ctx = canvas.getContext('2d');
          await page.render({ canvasContext: ctx, viewport, canvas }).promise;
        }
      } catch (err) {
        console.error('[pdf.js fallback] failed:', err);
        pdfjsBox.innerHTML =
          '<div class="flex flex-col items-center justify-center h-full p-6 text-center text-white/80">' +
          '<p class="mb-4 text-sm">Preview unavailable. Use the button below to open the resume.</p>' +
          '<a href="' + RESUME_URL + '" target="_blank" rel="noopener noreferrer" class="px-4 py-2 rounded bg-white text-black font-semibold">Open Resume (PDF)</a>' +
          '</div>';
      }
    }

    if (isFirefox) {
      showPdfJs();
      loadPdfJs();
      return;
    }

    if (gdocs) {
      let gdocsLoaded = false;
      const onLoad = () => { gdocsLoaded = true; };
      gdocs.addEventListener('load', onLoad, { once: true });
      setTimeout(() => {
        if (!gdocsLoaded) {
          showPdfJs();
          loadPdfJs();
        }
      }, 6000);
    }
  })();
</script>
