---
import { FlipFadeText } from './ui/flip-fade-text';
import { LineHoverLink } from './ui/line-hover-link';
import { GenerateButton } from './ui/generate-button';
import { BorderBeam } from './ui/border-beam';

const RESUME_PDF_URL = "https://github.com/AyushSaha184/Resume/releases/download/latestt/Resume.pdf";

const resumeHeadings = [
  "PROFESSIONAL RESUME",
  "ACADEMIC & TECHNICAL EXPERIENCE",
  "VERIFIED CANDIDATE RECORD"
];
---

<section id="resume" class="relative py-24 sm:py-36 px-5 sm:px-8 bg-[#030406] border-t border-white/10">
  <div class="shell">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-12">
      <div>
        <!-- Vengeance UI Flip Fade Text Heading (Clean Single-Color White) -->
        <FlipFadeText
          client:visible
          words={resumeHeadings}
          interval={3500}
          letterDuration={0.5}
          staggerDelay={0.04}
          className="justify-start text-left min-h-[90px]"
          textClassName="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white max-w-3xl"
        />
      </div>

      <!-- Vengeance UI Generate Button for Download Resume -->
      <GenerateButton
        client:visible
        href={RESUME_PDF_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        Download Resume
      </GenerateButton>
    </div>

    <!-- Document Panel -->
    <div class="relative rounded-3xl bg-[#090b10] p-4 sm:p-6 text-white shadow-2xl overflow-hidden border border-white/15">
      <!-- 2 White Animated Border Beams -->
      <BorderBeam client:visible size={380} duration={8} delay={0} colorFrom="#ffffff" colorTo="rgba(255,255,255,0)" borderWidth={1.5} />
      <BorderBeam client:visible size={380} duration={8} delay={4} colorFrom="#ffffff" colorTo="rgba(255,255,255,0)" borderWidth={1.5} />

      <div class="flex items-center justify-between pb-4 mb-4 border-b border-white/10 text-xs text-white/50">
        <span class="text-white/90 font-semibold font-sans">Resume.pdf</span>
      </div>

      <div class="relative rounded-2xl overflow-hidden bg-white/5">
        <iframe
          src={`https://docs.google.com/gview?embedded=true&url=${encodeURIComponent(RESUME_PDF_URL)}`}
          class="w-full h-[500px] sm:h-[700px] md:h-[900px] border-none"
          title="Ayush Saha Resume"
          id="resume-iframe"
        ></iframe>
      </div>
    </div>
  </div>
</section>
