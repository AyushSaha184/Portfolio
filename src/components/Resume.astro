---
import { FlipFadeText } from './ui/flip-fade-text';
import GenerateButton from './ui/GenerateButton.astro';
import BorderBeam from './ui/BorderBeam.astro';

const RESUME_PDF_URL = "/Resume.pdf";
const GITHUB_RESUME_URL = "https://github.com/AyushSaha184/Resume/releases/download/latestt/Resume.pdf";

const resumeHeadings = [
  "PROFESSIONAL RESUME",
  "ACADEMIC & TECHNICAL RECORD",
  "VERIFIED CANDIDATE PROFILE"
];
---

<!-- Vengeance UI Resume Section (Single Universal PDF Resume Viewer for Mobile & Desktop) -->
<section id="resume" class="relative py-20 sm:py-36 px-4 sm:px-8 bg-transparent border-t border-white/10" aria-labelledby="resume-heading">
  <div class="shell">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-8 sm:mb-14">
      <div>
        <!-- Vengeance UI Flip Fade Text Heading with semantic h2 -->
        <h2 id="resume-heading" class="sr-only">Professional Resume</h2>
        <FlipFadeText
          client:visible
          words={resumeHeadings}
          interval={3500}
          letterDuration={0.5}
          staggerDelay={0.04}
          className="justify-start text-left min-h-[70px] sm:min-h-[90px]"
          textClassName="text-2xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white max-w-3xl"
        />
      </div>

      <!-- Download Resume PDF Button -->
      <GenerateButton
        href={GITHUB_RESUME_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Download Ayush Saha Resume (PDF)"
      >
        Download Resume (PDF)
      </GenerateButton>
    </div>

    <!-- Single Universal PDF Document Panel (Renders on Mobile, Tablet & Desktop) -->
    <div class="relative rounded-3xl bg-[#090b10] p-4 sm:p-7 text-white shadow-2xl overflow-hidden border border-white/15">
      <!-- 2 White Animated Border Beams -->
      <BorderBeam size={360} duration={8} delay={0} colorFrom="#ffffff" colorTo="rgba(255,255,255,0)" borderWidth={1.5} />
      <BorderBeam size={360} duration={8} delay={4} colorFrom="#ffffff" colorTo="rgba(255,255,255,0)" borderWidth={1.5} />

      <!-- Top Header Bar -->
      <div class="flex items-center justify-between pb-4 mb-4 border-b border-white/10 text-xs sm:text-sm text-white/70">
        <div class="flex items-center gap-3">
          <span class="font-bold text-white text-sm sm:text-base">Resume.pdf</span>
        </div>
      </div>

      <!-- Universal High-Quality PDF Viewer (Single Viewer for Mobile & Desktop) -->
      <div class="relative w-full rounded-2xl overflow-hidden bg-[#030406] border border-white/10">
        <div
          id="resume-pdfjs"
          class="w-full min-h-[550px] sm:min-h-[750px] md:min-h-[950px] overflow-auto bg-[#030406] p-2 sm:p-4 flex flex-col items-center justify-center"
          aria-label="Ayush Saha Resume PDF"
        >
          <!-- Loading State Spinner -->
          <div id="resume-loading" class="flex flex-col items-center justify-center py-24 text-white/60 gap-3">
            <svg class="animate-spin h-8 w-8 text-white/70" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
            <span class="text-xs tracking-wider font-mono">RENDERING RESUME...</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const PDFJS_VERSION = '4.0.379';
    const PDFJS_CDN = `https://cdnjs.cloudflare.com/ajax/libs/pdf.js/${PDFJS_VERSION}/pdf.min.mjs`;
    const PDFJS_WORKER = `https://cdnjs.cloudflare.com/ajax/libs/pdf.js/${PDFJS_VERSION}/pdf.worker.min.mjs`;
    const RESUME_URL = '/Resume.pdf';
    const GITHUB_RESUME_URL = 'https://github.com/AyushSaha184/Resume/releases/download/latestt/Resume.pdf';

    const pdfjsBox = document.getElementById('resume-pdfjs');
    if (!pdfjsBox) return;

    let cachedPdf = null;
    let renderTaskId = 0;

    async function renderResume() {
      const currentTaskId = ++renderTaskId;
      try {
        if (!cachedPdf) {
          const lib = await import(PDFJS_CDN);
          const pdfjsLib = lib.GlobalWorkerOptions ? lib : lib.default || lib;
          pdfjsLib.GlobalWorkerOptions.workerSrc = PDFJS_WORKER;
          const loadingTask = pdfjsLib.getDocument(RESUME_URL);
          cachedPdf = await loadingTask.promise;
        }

        if (currentTaskId !== renderTaskId) return;

        pdfjsBox.innerHTML = '';
        const total = Math.min(cachedPdf.numPages, 5);
        const dpr = window.devicePixelRatio || 1;
        const padding = window.innerWidth < 640 ? 16 : 32;
        const availableWidth = Math.max(300, pdfjsBox.clientWidth - padding);

        for (let i = 1; i <= total; i++) {
          if (currentTaskId !== renderTaskId) return;

          const page = await cachedPdf.getPage(i);
          const baseViewport = page.getViewport({ scale: 1 });
          const scale = Math.max(0.6, Math.min(1.6, availableWidth / baseViewport.width));
          const viewport = page.getViewport({ scale });

          const canvas = document.createElement('canvas');
          canvas.className = 'mx-auto my-2 rounded-xl shadow-2xl bg-white max-w-full';
          canvas.style.display = 'block';
          canvas.style.width = `${viewport.width}px`;
          canvas.style.height = `${viewport.height}px`;
          canvas.width = Math.floor(viewport.width * dpr);
          canvas.height = Math.floor(viewport.height * dpr);
          pdfjsBox.appendChild(canvas);

          const ctx = canvas.getContext('2d');
          const renderContext = {
            canvasContext: ctx,
            viewport: viewport,
            transform: dpr !== 1 ? [dpr, 0, 0, dpr, 0, 0] : null
          };
          await page.render(renderContext).promise;
        }
      } catch (err) {
        console.error('[Resume PDF render failed]:', err);
        pdfjsBox.innerHTML =
          '<div class="flex flex-col items-center justify-center py-20 px-6 text-center text-white/80">' +
          '<p class="mb-4 text-sm">Unable to render PDF preview directly.</p>' +
          '<a href="' + GITHUB_RESUME_URL + '" target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-xl bg-white text-black font-semibold hover:bg-white/90 transition-colors text-sm shadow-lg">' +
          'Open Resume (PDF)' +
          '</a>' +
          '</div>';
      }
    }

    renderResume();

    let resizeTimer = null;
    let lastWidth = window.innerWidth;
    window.addEventListener('resize', () => {
      if (Math.abs(window.innerWidth - lastWidth) > 30) {
        lastWidth = window.innerWidth;
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(renderResume, 200);
      }
    });
  })();
</script>
