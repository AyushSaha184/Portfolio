---
import { FlipFadeText } from './ui/flip-fade-text';
import { LineHoverLink } from './ui/line-hover-link';
import { GenerateButton } from './ui/generate-button';

const socials = [
  { url: "https://github.com/AyushSaha184", label: "GitHub" },
  { url: "https://www.linkedin.com/in/AyushSaha184", label: "LinkedIn" },
  { url: "mailto:ayushsaha1884@gmail.com", label: "Email" },
];

const navLinks = [
  { label: 'Home', href: '#home' },
  { label: 'Skills', href: '#skills' },
  { label: 'Projects', href: '#projects' },
  { label: 'Resume', href: '#resume' },
  { label: 'Contact', href: '#contact' },
];

const footerCTAWords = [
  "HAVE AN IDEA OR OPPORTUNITY?",
  "LET'S BUILD AGENTIC AI SYSTEMS",
  "AVAILABLE FOR FULL-TIME ROLES"
];
---

<footer id="contact" class="relative overflow-hidden bg-[#030406] text-white border-t border-white/10">
  <div class="shell relative z-10 pt-20 sm:pt-28 pb-10 px-5 sm:px-8">
    <!-- CTA Row -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 pb-16 border-b border-white/10">
      <div>
        <!-- Vengeance UI Flip Fade Text Heading (Clean Solid White) -->
        <FlipFadeText
          client:visible
          words={footerCTAWords}
          interval={3600}
          letterDuration={0.6}
          staggerDelay={0.05}
          className="justify-start text-left min-h-[110px]"
          textClassName="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight leading-[1.05] max-w-2xl text-white"
        />
      </div>

      <!-- Vengeance UI Generate Button for Contact CTA (No symbols/emojis inside) -->
      <GenerateButton
        client:visible
        href="mailto:ayushsaha1884@gmail.com"
      >
        Get in Touch
      </GenerateButton>
    </div>

    <!-- Columns -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 py-16">
      <!-- Col 1: Brand -->
      <div>
        <div class="flex items-center gap-2 font-bold text-xl mb-3 text-white">
          <span>Ayush Saha</span>
        </div>
        <p class="text-sm text-white/70 max-w-xs leading-relaxed">
          Fourth-year CS student specializing in RAG, LangGraph, and Agentic AI Systems. Dedicated to engineering robust machine learning pipelines and scalable software.
        </p>
      </div>

      <!-- Col 2: Navigation -->
      <div>
        <div class="text-xs uppercase tracking-wider text-white/40 font-semibold mb-4">Navigation</div>
        <ul class="flex flex-col gap-3 text-sm">
          {navLinks.map((link) => (
            <li>
              <LineHoverLink client:visible href={link.href} variant="slide" className="text-white/80 hover:text-white">
                {link.label}
              </LineHoverLink>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Social & Contact -->
      <div>
        <div class="text-xs uppercase tracking-wider text-white/40 font-semibold mb-4">Connect</div>
        <ul class="flex flex-col gap-3 text-sm">
          {socials.map((s) => (
            <li>
              <LineHoverLink client:visible href={s.url} target="_blank" variant="slide" className="text-white/80 hover:text-white">
                {s.label}
              </LineHoverLink>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Legal Bar (Clean Sans-Serif Font) -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-8 border-t border-white/10 text-xs text-white/60 font-sans">
      <span>© 2026 Ayush Saha. All rights reserved.</span>
    </div>
  </div>
</footer>
