---
import { FlipFadeText } from './ui/flip-fade-text';
import { LineHoverLink } from './ui/line-hover-link';
import { GenerateButton } from './ui/generate-button';

const navLinks = [
  { label: 'Home', href: '#home' },
  { label: 'Skills', href: '#skills' },
  { label: 'Projects', href: '#projects' },
  { label: 'Resume', href: '#resume' },
  { label: 'Contact', href: '#contact' },
];

const footerCTAWords = [
  "HAVE AN IDEA OR OPPORTUNITY?",
  "LET'S BUILD AGENTIC AI SYSTEMS",
  "AVAILABLE FOR FULL-TIME ROLES"
];
---

<footer id="contact" class="relative overflow-hidden bg-transparent text-white border-t border-white/10">
  <div class="shell relative z-10 pt-20 sm:pt-28 pb-10 px-5 sm:px-8">
    <!-- CTA Row -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 pb-16 border-b border-white/10">
      <div>
        <!-- Vengeance UI Flip Fade Text Heading -->
        <FlipFadeText
          client:visible
          words={footerCTAWords}
          interval={3600}
          letterDuration={0.6}
          staggerDelay={0.05}
          className="justify-start text-left min-h-[110px]"
          textClassName="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight leading-[1.05] max-w-2xl text-white"
        />
      </div>

      <!-- Vengeance UI Generate Button for Contact CTA -->
      <GenerateButton
        client:visible
        href="mailto:ayushsaha1884@gmail.com"
      >
        Get in Touch
      </GenerateButton>
    </div>

    <!-- Columns -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 py-16">
      <!-- Col 1: Brand -->
      <div>
        <div class="flex items-center gap-2 font-bold text-xl mb-3 text-white">
          <span>Ayush Saha</span>
        </div>
        <p class="text-sm text-white/70 max-w-xs leading-relaxed">
          Fourth-year CS student specializing in RAG, LangGraph, and Agentic AI Systems. Dedicated to engineering robust machine learning pipelines and scalable software.
        </p>
      </div>

      <!-- Col 2: Navigation -->
      <div>
        <div class="text-xs uppercase tracking-wider text-white/40 font-semibold mb-4">Navigation</div>
        <ul class="flex flex-col gap-3 text-sm">
          {navLinks.map((link) => (
            <li>
              <LineHoverLink client:visible href={link.href} variant="slide" className="text-white/80 hover:text-white">
                {link.label}
              </LineHoverLink>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Social & Contact with Official SVG Symbols -->
      <div>
        <div class="text-xs uppercase tracking-wider text-white/40 font-semibold mb-4">Connect</div>
        <ul class="flex flex-col gap-3.5 text-sm">
          <li>
            <LineHoverLink client:visible href="https://github.com/AyushSaha184" target="_blank" rel="noopener noreferrer" variant="slide" className="flex items-center gap-2 text-white/80 hover:text-white">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
              <span>GitHub</span>
            </LineHoverLink>
          </li>
          <li>
            <LineHoverLink client:visible href="https://www.linkedin.com/in/AyushSaha184" target="_blank" rel="noopener noreferrer" variant="slide" className="flex items-center gap-2 text-white/80 hover:text-white">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.72a1.47 1.47 0 1 0 0 2.94 1.47 1.47 0 0 0 0-2.94Z"/>
              </svg>
              <span>LinkedIn</span>
            </LineHoverLink>
          </li>
          <li>
            <LineHoverLink client:visible href="mailto:ayushsaha1884@gmail.com" variant="slide" className="flex items-center gap-2 text-white/80 hover:text-white">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-none stroke-current stroke-2 shrink-0" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span>Email</span>
            </LineHoverLink>
          </li>
        </ul>
      </div>
    </div>

    <!-- Legal Bar -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-8 border-t border-white/10 text-xs text-white/60 font-sans">
      <span>© 2026 Ayush Saha. All rights reserved.</span>
    </div>
  </div>
</footer>
