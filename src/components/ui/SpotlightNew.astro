---
interface Props {
  gradientFirst?: string;
  gradientSecond?: string;
  gradientThird?: string;
  translateY?: number;
  className?: string;
}

const {
  gradientFirst = "radial-gradient(68.54% 68.72% at 55.02% 31.46%, hsla(210, 100%, 85%, .12) 0%, hsla(210, 100%, 55%, .03) 50%, hsla(210, 100%, 45%, 0) 80%)",
  gradientSecond = "radial-gradient(50% 50% at 50% 50%, hsla(210, 100%, 85%, .08) 0%, hsla(210, 100%, 55%, .02) 80%, transparent 100%)",
  gradientThird = "radial-gradient(50% 50% at 50% 50%, hsla(210, 100%, 85%, .05) 0%, hsla(210, 100%, 45%, .02) 80%, transparent 100%)",
  translateY = -350,
  className = "",
} = Astro.props;
---

<div
  class:list={[
    "pointer-events-none fixed inset-0 z-0 overflow-hidden bg-transparent transform-gpu will-change-transform",
    className,
  ]}
  style="contain: strict;"
  aria-hidden="true"
>
  <div class="pointer-events-none absolute left-1/2 top-0 -translate-x-1/2 w-full max-w-7xl h-full transform-gpu">
    <!-- Left Conical Spotlight Beam -->
    <div
      style={`transform: translateY(${translateY}px) rotate(-38deg);`}
      class="absolute -left-52 top-0 flex h-[800px] sm:h-[1400px] w-[320px] sm:w-[600px] flex-col items-center justify-center opacity-50 md:opacity-80"
    >
      <div
        style={`background: ${gradientFirst};`}
        class="w-full h-full rounded-full filter blur-[35px] md:blur-[90px]"
      ></div>
    </div>

    <!-- Right Conical Spotlight Beam -->
    <div
      style={`transform: translateY(${translateY}px) rotate(38deg);`}
      class="absolute -right-52 top-0 flex h-[800px] sm:h-[1400px] w-[320px] sm:w-[600px] flex-col items-center justify-center opacity-50 md:opacity-80"
    >
      <div
        style={`background: ${gradientFirst};`}
        class="w-full h-full rounded-full filter blur-[35px] md:blur-[90px]"
      ></div>
    </div>

    <!-- Center Ambient Spotlight Blur -->
    <div
      class="absolute left-1/2 top-[-180px] -translate-x-1/2 w-[450px] md:w-[900px] h-[450px] md:h-[900px] rounded-full opacity-30 md:opacity-50 filter blur-[45px] md:blur-[150px]"
      style={`background: ${gradientSecond};`}
    ></div>

    <!-- Bottom Ambient Glow -->
    <div
      class="absolute left-1/2 bottom-[-200px] -translate-x-1/2 w-[350px] md:w-[700px] h-[300px] md:h-[500px] rounded-full opacity-20 md:opacity-30 filter blur-[35px] md:blur-[130px]"
      style={`background: ${gradientThird};`}
    ></div>
  </div>
</div>
