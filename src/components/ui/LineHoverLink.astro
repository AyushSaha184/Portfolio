---
interface Props {
  variant?: 'slide' | 'double' | 'grow' | 'strike' | 'fade' | 'pulse' | 'swap' | 'sweep' | 'bounce' | 'arc' | 'scribble';
  href?: string;
  target?: string;
  rel?: string;
  className?: string;
  asSpan?: boolean;
  title?: string;
  'aria-label'?: string;
}

const {
  variant = 'slide',
  href,
  target,
  rel,
  className = '',
  asSpan = false,
  title,
  'aria-label': ariaLabel,
  ...props
} = Astro.props;

const needsSpan = ['strike', 'bounce', 'arc', 'scribble'].includes(variant);
const svgVariant = variant === 'arc' ? 'arc' : variant === 'scribble' ? 'scribble' : null;
---

{asSpan ? (
  <span
    class:list={['link-hover', `link-hover--${variant}`, className]}
    {...props}
  >
    {needsSpan ? <span><slot /></span> : <slot />}
    {svgVariant === 'arc' && (
      <svg class="link-hover__graphic link-hover__graphic--stroke link-hover__graphic--arc" width="100%" height="18" viewBox="0 0 59 18">
        <path d="M.945.149C12.3 16.142 43.573 22.572 58.785 10.842" pathLength="1" />
      </svg>
    )}
    {svgVariant === 'scribble' && (
      <svg class="link-hover__graphic link-hover__graphic--stroke link-hover__graphic--scribble" width="100%" height="9" viewBox="0 0 101 9">
        <path d="M.426 1.973C4.144 1.567 17.77-.514 21.443 1.48 24.296 3.026 24.844 4.627 27.5 7c3.075 2.748 6.642-4.141 10.066-4.688 7.517-1.2 13.237 5.425 17.59 2.745C58.5 3 60.464-1.786 66 2c1.996 1.365 3.174 3.737 5.286 4.41 5.423 1.727 25.34-7.981 29.14-1.294" pathLength="1" />
      </svg>
    )}
  </span>
) : (
  <a
    href={href}
    target={target}
    rel={target === '_blank' && !rel ? 'noopener noreferrer' : rel}
    title={title}
    aria-label={ariaLabel}
    class:list={['link-hover', `link-hover--${variant}`, className]}
    {...props}
  >
    {needsSpan ? <span><slot /></span> : <slot />}
    {svgVariant === 'arc' && (
      <svg class="link-hover__graphic link-hover__graphic--stroke link-hover__graphic--arc" width="100%" height="18" viewBox="0 0 59 18">
        <path d="M.945.149C12.3 16.142 43.573 22.572 58.785 10.842" pathLength="1" />
      </svg>
    )}
    {svgVariant === 'scribble' && (
      <svg class="link-hover__graphic link-hover__graphic--stroke link-hover__graphic--scribble" width="100%" height="9" viewBox="0 0 101 9">
        <path d="M.426 1.973C4.144 1.567 17.77-.514 21.443 1.48 24.296 3.026 24.844 4.627 27.5 7c3.075 2.748 6.642-4.141 10.066-4.688 7.517-1.2 13.237 5.425 17.59 2.745C58.5 3 60.464-1.786 66 2c1.996 1.365 3.174 3.737 5.286 4.41 5.423 1.727 25.34-7.981 29.14-1.294" pathLength="1" />
      </svg>
    )}
  </a>
)}
