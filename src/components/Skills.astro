---
import { FlipFadeText } from './ui/flip-fade-text';
import LineHoverLink from './ui/LineHoverLink.astro';
import GenerateButton from './ui/GenerateButton.astro';
import BorderBeam from './ui/BorderBeam.astro';

const skillCategories = [
  { title: "Generative AI", skills: ["Retrieval-Augmented Generation (RAG)", "Agentic AI", "Model Context Protocol (MCP)", "Prompt Engineering", "NLP", "Transformers", "Open-Source LLMs"] },
  { title: "Frameworks & Libraries", skills: ["FastAPI", "LangChain", "LangGraph", "LlamaIndex"] },
  { title: "Languages", skills: ["Go", "Python", "Java"] },
  { title: "Databases", skills: ["PostgreSQL", "MySQL", "Redis", "Qdrant"] },
  { title: "Cloud & DevOps", skills: ["Docker", "Vercel", "Supabase", "Neon", "Render", "Git"] },
  { title: "Coursework", skills: ["Operating Systems", "Database Management Systems", "Computer Networks", "Object-Oriented Programming"] },
];

const skillsHeadings = [
  "TECHNICAL STACK & CORE EXPERTISE",
  "GENERATIVE AI & AGENTIC SYSTEMS",
  "HIGH PERFORMANCE INFRASTRUCTURE"
];
---

<!-- Vengeance UI Skills Section with Squarish Proportions & Bottom Clearance -->
<section id="skills" class="relative py-20 sm:py-36 px-4 sm:px-8 bg-transparent overflow-visible" aria-labelledby="skills-heading">
  <div class="shell">
    <div class="flex flex-col items-center text-center mb-8 sm:mb-14">
      <!-- Heading in Solid Clean White with semantic h2 -->
      <h2 id="skills-heading" class="sr-only">Technical Stack & Core Expertise</h2>
      <FlipFadeText
        client:visible
        words={skillsHeadings}
        interval={3500}
        letterDuration={0.5}
        staggerDelay={0.04}
        className="justify-center text-center min-h-[80px] sm:min-h-[100px]"
        textClassName="text-2xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white max-w-4xl"
      />
    </div>

    <!-- 3D Cylinder Stage with Plenty of Vertical Clearance -->
    <div class="cylinder-stage pt-6 sm:pt-10 pb-8 sm:pb-12 min-h-[28rem] sm:min-h-[34rem] overflow-visible">
      <div id="cylinder-ring" class="cylinder-ring">
        {skillCategories.map((category, idx) => (
          <div
            class="cylinder-card p-4 sm:p-7 md:p-8 text-white flex flex-col justify-between"
            data-index={idx}
            style={`transform: rotateY(${idx * 60}deg) translateZ(420px);`}
          >
            <!-- 2 White Animated Border Beams -->
            <BorderBeam size={280} duration={6} delay={0} colorFrom="#ffffff" colorTo="rgba(255,255,255,0)" borderWidth={1.5} />
            <BorderBeam size={280} duration={6} delay={3} colorFrom="#ffffff" colorTo="rgba(255,255,255,0)" borderWidth={1.5} />

            <div>
              <!-- Clean Header: Title + Skills Count Badge -->
              <div class="mb-3 sm:mb-5 pb-3 border-b border-white/10 flex items-center justify-between gap-2">
                <h3 class="font-extrabold text-xl sm:text-2xl md:text-3xl text-white tracking-tight">{category.title}</h3>
                <span class="text-[10px] sm:text-xs font-semibold px-2.5 py-1 rounded-full bg-white/10 border border-white/15 text-white/70 shrink-0">{category.skills.length} Technologies</span>
              </div>

              <!-- Frameworks & Skill Names -->
              <div class="flex flex-wrap gap-2 sm:gap-2.5 pt-1">
                {category.skills.map((skill) => (
                  <LineHoverLink variant="slide" asSpan className="px-2.5 sm:px-3.5 py-1.5 text-xs sm:text-sm font-semibold rounded-xl bg-white/10 border border-white/20 text-white">
                    {skill}
                  </LineHoverLink>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Navigation Controls for 3D Carousel (Positioned cleanly below cylinder with zero overlap) -->
    <div class="flex items-center justify-center gap-4 sm:gap-6 mt-12 sm:mt-16 relative z-20">
      <GenerateButton id="cylinder-prev" aria-label="Previous Category">
        Prev
      </GenerateButton>

      <span id="cylinder-indicator" class="text-xs sm:text-sm font-semibold tracking-widest text-white/70 min-w-[4rem] text-center">
        1 / 6
      </span>

      <GenerateButton id="cylinder-next" aria-label="Next Category">
        Next
      </GenerateButton>
    </div>
  </div>
</section>

<script>
  (() => {
    const ring = document.getElementById('cylinder-ring');
    const prevBtn = document.getElementById('cylinder-prev');
    const nextBtn = document.getElementById('cylinder-next');
    const indicator = document.getElementById('cylinder-indicator');
    const skillsSection = document.getElementById('skills');

    let currentAngle = 0;
    let currentIndex = 0;
    const total = 6;
    const angleStep = 60;
    let isHovered = false;
    let autoRotateTimer: any = null;
    const AUTO_ROTATE_DELAY_MS = 8000;

    function getRadius() {
      // 260px on mobile for clean side margins and squarish card proportions
      return window.innerWidth < 640 ? 260 : window.innerWidth < 1024 ? 350 : 420;
    }

    function updateCardPositions() {
      const radius = getRadius();
      const cards = ring?.querySelectorAll('.cylinder-card');
      cards?.forEach((card, idx) => {
        const el = card as HTMLElement;
        el.style.transform = `rotateY(${idx * angleStep}deg) translateZ(${radius}px)`;
      });
      updateDepthStacking();
    }

    function updateDepthStacking() {
      if (ring) {
        ring.style.transform = `rotateY(${currentAngle}deg)`;
      }

      const cards = ring?.querySelectorAll('.cylinder-card');
      cards?.forEach((card, idx) => {
        const el = card as HTMLElement;
        let relAngle = ((idx * angleStep + currentAngle) % 360 + 360) % 360;
        if (relAngle > 180) relAngle = 360 - relAngle;

        if (relAngle < 30) {
          // Active front card
          el.style.zIndex = '30';
          el.style.opacity = '1';
          el.style.filter = 'none';
        } else if (relAngle < 90) {
          // Immediate side cards
          el.style.zIndex = '10';
          el.style.opacity = '0.35';
          el.style.filter = 'blur(2px)';
        } else {
          // Back hidden cards
          el.style.zIndex = '1';
          el.style.opacity = '0.08';
          el.style.filter = 'blur(4px)';
        }
      });

      if (indicator) {
        indicator.textContent = `${currentIndex + 1} / ${total}`;
      }
    }

    function startAutoRotate() {
      stopAutoRotate();
      autoRotateTimer = setInterval(() => {
        if (!isHovered) {
          currentAngle -= angleStep;
          currentIndex = (currentIndex + 1) % total;
          updateDepthStacking();
        }
      }, AUTO_ROTATE_DELAY_MS);
    }

    function stopAutoRotate() {
      if (autoRotateTimer) {
        clearInterval(autoRotateTimer);
        autoRotateTimer = null;
      }
    }

    function resetAutoRotateWithDelay() {
      stopAutoRotate();
      startAutoRotate();
    }

    if (skillsSection) {
      skillsSection.addEventListener('mouseenter', () => { isHovered = true; });
      skillsSection.addEventListener('mouseleave', () => { isHovered = false; resetAutoRotateWithDelay(); });
      skillsSection.addEventListener('touchstart', () => { isHovered = true; }, { passive: true });
      skillsSection.addEventListener('touchend', () => { isHovered = false; resetAutoRotateWithDelay(); }, { passive: true });
    }

    updateCardPositions();
    window.addEventListener('resize', updateCardPositions);

    prevBtn?.addEventListener('click', () => {
      currentAngle += angleStep;
      currentIndex = (currentIndex - 1 + total) % total;
      updateDepthStacking();
      resetAutoRotateWithDelay();
    });

    nextBtn?.addEventListener('click', () => {
      currentAngle -= angleStep;
      currentIndex = (currentIndex + 1) % total;
      updateDepthStacking();
      resetAutoRotateWithDelay();
    });

    // Pause auto-rotation when Skills section is out of viewport
    if ('IntersectionObserver' in window && skillsSection) {
      const obs = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) {
          startAutoRotate();
        } else {
          stopAutoRotate();
        }
      }, { threshold: 0.1 });
      obs.observe(skillsSection);
    } else {
      startAutoRotate();
    }
  })();
</script>
