---
import { FlipFadeText } from './ui/flip-fade-text';
import { LineHoverLink } from './ui/line-hover-link';
import { GenerateButton } from './ui/generate-button';
import { BorderBeam } from './ui/border-beam';

const skillCategories = [
  { title: "Generative AI", skills: ["Retrieval-Augmented Generation (RAG)", "Agentic AI", "Model Context Protocol (MCP)", "Prompt Engineering", "NLP", "Transformers", "Open-Source LLMs"] },
  { title: "Frameworks & Libraries", skills: ["FastAPI", "LangChain", "LangGraph", "LlamaIndex"] },
  { title: "Languages", skills: ["Go", "Python", "Java"] },
  { title: "Databases", skills: ["PostgreSQL", "MySQL", "Redis", "Qdrant"] },
  { title: "Cloud & DevOps", skills: ["Docker", "Vercel", "Supabase", "Neon", "Render", "Git"] },
  { title: "Coursework", skills: ["Operating Systems", "Database Management Systems", "Computer Networks", "Object-Oriented Programming"] },
];

const skillsHeadings = [
  "TECHNICAL STACK & CORE EXPERTISE",
  "GENERATIVE AI & AGENTIC SYSTEMS",
  "HIGH PERFORMANCE INFRASTRUCTURE"
];
---

<!-- Vengeance UI Skills Section with Clean 3D Cylinder Cards -->
<section id="skills" class="relative py-28 sm:py-40 px-5 sm:px-8 bg-transparent overflow-visible">
  <div class="shell">
    <div class="flex flex-col items-center text-center mb-16">
      <!-- Heading in Solid Clean White -->
      <FlipFadeText
        client:visible
        words={skillsHeadings}
        interval={3500}
        letterDuration={0.5}
        staggerDelay={0.04}
        className="justify-center text-center min-h-[100px]"
        textClassName="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white max-w-4xl"
      />
    </div>

    <!-- 3D Cylinder Stage with Height Padding to Ensure Top and Bottom are Never Cut Off -->
    <div class="cylinder-stage py-16 min-h-[38rem] overflow-visible">
      <div id="cylinder-ring" class="cylinder-ring">
        {skillCategories.map((category, idx) => (
          <div
            class="cylinder-card p-6 sm:p-8 text-white flex flex-col justify-between"
            data-index={idx}
            style={`transform: rotateY(${idx * 60}deg) translateZ(420px);`}
          >
            <!-- 2 White Animated Border Beams -->
            <BorderBeam client:visible size={280} duration={6} delay={0} colorFrom="#ffffff" colorTo="rgba(255,255,255,0)" borderWidth={1.5} />
            <BorderBeam client:visible size={280} duration={6} delay={3} colorFrom="#ffffff" colorTo="rgba(255,255,255,0)" borderWidth={1.5} />

            <div>
              <!-- Clean Header: Title + Skills Count Badge -->
              <div class="mb-6 pb-4 border-b border-white/10 flex items-center justify-between gap-3">
                <h3 class="font-extrabold text-2xl sm:text-3xl text-white tracking-tight">{category.title}</h3>
                <span class="text-xs font-semibold px-3 py-1 rounded-full bg-white/10 border border-white/15 text-white/70 shrink-0">{category.skills.length} Technologies</span>
              </div>

              <!-- Frameworks & Skill Names -->
              <div class="flex flex-wrap gap-2.5 pt-2">
                {category.skills.map((skill) => (
                  <LineHoverLink client:visible variant="slide" asSpan className="px-4 py-2 text-sm font-semibold rounded-xl bg-white/10 border border-white/20 text-white">
                    {skill}
                  </LineHoverLink>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Vengeance UI Generate Buttons for Carousel Controls (No font-mono) -->
    <div class="flex items-center justify-center gap-4 mt-16">
      <GenerateButton client:visible id="cylinder-prev">
        PREV
      </GenerateButton>
      <span class="text-xs text-white/60 font-medium px-2" id="cylinder-indicator">1 / 6</span>
      <GenerateButton client:visible id="cylinder-next">
        NEXT
      </GenerateButton>
    </div>
  </div>
</section>

<script>
  (function() {
    const ring = document.getElementById('cylinder-ring');
    const prevBtn = document.getElementById('cylinder-prev');
    const nextBtn = document.getElementById('cylinder-next');
    const indicator = document.getElementById('cylinder-indicator');

    let currentAngle = 0;
    let currentIndex = 0;
    const total = 6;
    const angleStep = 60;

    function updateCylinder() {
      if (ring) {
        ring.style.transform = `rotateY(${currentAngle}deg)`;
      }
      if (indicator) {
        indicator.textContent = `${currentIndex + 1} / ${total}`;
      }
    }

    prevBtn?.addEventListener('click', () => {
      currentAngle += angleStep;
      currentIndex = (currentIndex - 1 + total) % total;
      updateCylinder();
    });

    nextBtn?.addEventListener('click', () => {
      currentAngle -= angleStep;
      currentIndex = (currentIndex + 1) % total;
      updateCylinder();
    });

    setInterval(() => {
      currentAngle -= angleStep;
      currentIndex = (currentIndex + 1) % total;
      updateCylinder();
    }, 4500);
  })();
</script>
