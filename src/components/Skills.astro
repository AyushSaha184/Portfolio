---
const skillCategories = [
  { title: "Languages", icon: "fas fa-code", skills: ["Java", "Python", "C"] },
  { title: "Libraries/Frameworks", icon: "fas fa-layer-group", skills: ["FastAPI", "LangChain", "LangGraph", "LlamaIndex", "FastMCP", "REST APIs"] },
  { title: "Databases", icon: "fas fa-database", skills: ["PostgreSQL", "MySQL", "Redis", "Qdrant"] },
  { title: "Cloud/Deployment", icon: "fas fa-cloud", skills: ["Docker", "Vercel", "Supabase", "Neon", "Render", "Git", "Linux"] },
  { title: "Coursework", icon: "fas fa-book", skills: ["Data Structures & Algorithms", "Operating Systems", "DBMS", "Computer Networks", "OOP"] },
  { title: "Generative AI", icon: "fas fa-robot", skills: ["RAG", "AI Agents", "LangGraph", "NLP", "Transformers", "Open Source LLMs", "MCP"], primary: true },
];
---

<section id="skills" class="section-skills section-observer relative min-h-screen py-32 px-6 bg-cyber-dark">
  <div class="max-w-6xl mx-auto relative z-10">
    <div class="terminal-window">
      <div class="terminal-header">
        <span class="terminal-dot red"></span>
        <span class="terminal-dot yellow"></span>
        <span class="terminal-dot green"></span>
        <span class="terminal-title cmd-fade-unit" id="skills-terminal-title">_</span>
      </div>

      <div class="terminal-status">
        <span class="status-item">
          <span class="status-label">MEM</span>
          <span class="status-value" id="status-mem">842MB</span>
        </span>
        <span class="status-divider">|</span>
        <span class="status-item">
          <span class="status-label">PROC</span>
          <span class="status-value" id="status-proc">load_stack.sh</span>
        </span>
        <span class="status-divider">|</span>
        <span class="status-item">
          <span class="status-label">PID</span>
          <span class="status-value" id="status-pid">1337</span>
        </span>
        <span class="status-divider">|</span>
        <span class="status-item">
          <span class="status-label">UPTIME</span>
          <span class="status-value" id="status-uptime">00:00:00</span>
        </span>
        <span class="status-divider">|</span>
        <span class="status-item">
          <span class="status-label">STATUS</span>
          <span class="status-value green" id="status-state">BOOT</span>
        </span>
      </div>

      <div class="terminal-body">
        <h2 class="font-display text-3xl font-bold text-cyber-text mb-2">
          <span class="text-cyber-orange command-prompt"></span>Technical Skills
        </h2>
        <p class="text-cyber-muted text-sm mb-6 font-mono cmd-fade-unit" id="skills-subtitle">
          <span class="text-cyber-orange">$</span> <span id="cmd-line">root@ayush:~/skills$ <span class="text-cyber-text">_</span></span>
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="skills-grid">
          {skillCategories.map((category) => (
            <div class="skill-card bg-cyber-black border border-cyber-orange/15 rounded-lg p-5 hover:border-cyber-orange/50 hover:shadow-[0_0_30px_rgba(255,107,0,0.12)] transition-all duration-200 group relative overflow-hidden">
              <span class="card-noise"></span>
              <span class="card-glow-tl"></span>
              <span class="card-glow-br"></span>

              {category.primary && (
                <div class="absolute top-3 right-3 z-10 border border-cyber-cyan/30 bg-cyber-cyan/5 text-cyber-cyan text-[9px] uppercase tracking-[0.15em] px-2 py-0.5 rounded">
                  primary stack
                </div>
              )}

              {category.primary && (
                <div class="absolute inset-0 bg-gradient-to-br from-cyber-orange/[0.03] to-transparent pointer-events-none z-[1]"></div>
              )}

              <div class="relative z-10">
                <div class="flex items-center gap-3 mb-4">
                  <i class={`${category.icon} ${category.primary ? 'text-cyber-cyan' : 'text-cyber-orange'} text-lg group-hover:animate-neon-pulse`}></i>
                  <h3 class="font-display text-lg font-semibold text-cyber-text">
                    {category.title.split(' ')[0]}
                    {category.title.includes(' ') && <span class={category.primary ? 'text-cyber-cyan' : 'text-cyber-orange'}> {category.title.split(' ').slice(1).join(' ')}</span>}
                  </h3>
                </div>

                <div class="flex flex-wrap gap-2">
                  {category.skills.map((skill) => (
                    <span class="skill-chip group/chip relative overflow-hidden">
                      <span class="relative z-10">{skill}</span>
                      <span class="chip-scanline"></span>
                      <span class="chip-cursor"></span>
                    </span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const titleEl = document.getElementById('skills-terminal-title');
    const subtitleEl = document.getElementById('skills-subtitle');
    const cmdLine = document.getElementById('cmd-line');
    const cards = document.querySelectorAll('.skill-card');
    const statusMem = document.getElementById('status-mem');
    const statusState = document.getElementById('status-state');
    const statusUptime = document.getElementById('status-uptime');

    const fullTitle = 'root@ayush:~/skills$ ./load_stack.sh';
    const bootLines = [
      '<span class="text-cyber-orange">$</span> > scanning kernel modules...',
      '<span class="text-cyber-orange">$</span> > parsing neural topology...',
      '<span class="text-cyber-orange">$</span> > linking dependencies...',
      '<span class="text-cyber-orange">$</span> <span class="text-green-400">6 modules loaded — STATUS: RUNNING</span>'
    ];

    let uptimeSeconds = 0;
    let uptimeInterval = null;

    function formatUptime(s) {
      const h = String(Math.floor(s / 3600)).padStart(2, '0');
      const m = String(Math.floor((s % 3600) / 60)).padStart(2, '0');
      const sec = String(s % 60).padStart(2, '0');
      return `${h}:${m}:${sec}`;
    }

    function updateUptime() {
      uptimeSeconds++;
      if (statusUptime) statusUptime.textContent = formatUptime(uptimeSeconds);
    }

    function fadeUnit(el, html, delay, cb) {
      if (!el) return;
      el.classList.remove('cmd-visible');
      void el.offsetHeight;
      setTimeout(() => {
        el.innerHTML = html;
        requestAnimationFrame(() => {
          el.classList.add('cmd-visible');
          if (cb) setTimeout(cb, 400);
        });
      }, delay || 0);
    }

    function showBootLines(idx) {
      if (idx >= bootLines.length) {
        fadeUnit(cmdLine, '<span class="text-cyber-orange">root@ayush:~/skills$</span> <span class="text-cyber-text">./load_stack.sh</span><span class="text-green-400">  [DONE]</span>', 0, () => {
          if (statusState) { statusState.textContent = 'RUNNING'; statusState.className = 'status-value green'; }
          uptimeInterval = setInterval(updateUptime, 1000);
          revealCards();
        });
        return;
      }
      subtitleEl.innerHTML = bootLines[idx];
      fadeUnit(subtitleEl, bootLines[idx], 0, () => {
        if (idx === 0 && statusState) statusState.textContent = 'SCAN';
        if (idx === 1 && statusState) statusState.textContent = 'PARSE';
        if (idx === 2 && statusState) statusState.textContent = 'LINK';
        setTimeout(() => showBootLines(idx + 1), 350);
      });
    }

    function revealCards() {
      cards.forEach((card, i) => {
        card.style.opacity = '0';
        card.style.transform = 'translateY(20px)';
        setTimeout(() => {
          card.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
          card.style.opacity = '1';
          card.style.transform = 'translateY(0)';
        }, i * 100);
      });
    }

    const memValues = ['842MB', '856MB', '834MB', '863MB', '847MB'];
    function jitterMem() {
      if (statusMem && statusState?.textContent === 'RUNNING') {
        statusMem.textContent = memValues[Math.floor(Math.random() * memValues.length)];
      }
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          if (statusState) statusState.textContent = 'BOOT';
          fadeUnit(titleEl, fullTitle + '  ', 0, () => setTimeout(() => showBootLines(0), 300));
          setInterval(jitterMem, 3000);
          observer.disconnect();
        }
      });
    }, { threshold: 0.3 });

    const target = titleEl?.closest('.terminal-window');
    if (target) observer.observe(target);

    cards.forEach(card => {
      card.addEventListener('mouseenter', () => {
        const chips = card.querySelectorAll('.skill-chip');
        chips.forEach((chip, i) => {
          chip.style.transition = 'transform 0.2s ease, box-shadow 0.2s ease';
          setTimeout(() => {
            chip.style.transform = 'translateY(-1px)';
            chip.style.boxShadow = '0 0 8px rgba(255,107,0,0.15)';
          }, i * 40);
        });
      });
      card.addEventListener('mouseleave', () => {
        const chips = card.querySelectorAll('.skill-chip');
        chips.forEach(chip => {
          chip.style.transform = '';
          chip.style.boxShadow = '';
        });
      });
    });
  })();
</script>
