---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Skills from '../components/Skills.astro';
import Projects from '../components/Projects.astro';
import Resume from '../components/Resume.astro';
import Footer from '../components/Footer.astro';
import { AISearchModal } from '../components/AISearchModal';
import { FlipText } from '../components/ui/flip-text';
import { LineHoverLink } from '../components/ui/line-hover-link';
import { LiquidMetalButton } from '../components/ui/liquid-metal';

const heroHeadlineWords = [
  "BUILDING AI-DRIVEN PRODUCTS",
  "RAG & AGENTIC AI SYSTEMS",
  "AUTONOMOUS MULTI-AGENT PIPELINES",
  "PRODUCTION-READY SERVICES"
];
---

<BaseLayout title="Ayush Saha | AI Engineer & CS Student">
  <Navigation />

  <main id="main" class="relative">
    <!-- Hero Section with Vengeance UI FlipText & Liquid Metal Buttons -->
    <section id="home" class="relative isolate overflow-hidden min-h-screen flex flex-col justify-start pt-36 sm:pt-44 md:pt-48 pb-20 px-5 sm:px-8">

      <!-- Soft Ambient Vignette Overlay -->
      <div class="absolute inset-0 bg-gradient-to-b from-[#030406]/50 via-transparent to-transparent pointer-events-none z-[1]"></div>
      <div class="absolute inset-0 bg-radial-at-c from-transparent via-[#030406]/30 to-transparent pointer-events-none z-[1]"></div>

      <!-- Content Container -->
      <div class="shell relative z-20 flex flex-col gap-8 max-w-4xl">
        <!-- Vengeance UI FlipText Headline (Fixed container height so body text NEVER shifts/misaligns) -->
        <div class="w-full text-left flex flex-col items-start justify-start h-[160px] sm:h-[190px] md:h-[210px] shrink-0 overflow-hidden">
          <FlipText
            client:load
            words={heroHeadlineWords}
            interval={3500}
            duration={0.6}
            textClassName="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white leading-tight"
          />
        </div>

        <!-- Vengeance UI Line Hover Link Main Page Text (Clean single-color, no period wrap misalignment) -->
        <div class="text-base sm:text-lg text-white/80 leading-relaxed space-y-4 font-normal max-w-3xl">
          <p>
            Fourth-year Computer Science student at{" "}
            <span class="inline whitespace-nowrap">
              <LineHoverLink client:load variant="slide" href="https://sit-siliguri.ac.in" target="_blank" className="text-white font-semibold">
                Siliguri Institute of Technology, West Bengal.
              </LineHoverLink>
            </span>
          </p>
          <p>
            Specializing in{" "}
            <LineHoverLink client:load variant="slide" href="#skills" className="text-white font-semibold">
              RAG and Agentic AI Systems
            </LineHoverLink>
            . Strong focus on high-performance vector databases, system architecture, and building production-ready autonomous LLM tools.
          </p>
        </div>

        <!-- Vengeance UI Liquid Metal CTAs for View Projects & Get in Touch (Pure White Glow Shader Border, Sleeker Size, NO symbols/emojis) -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <LiquidMetalButton
            client:load
            href="#projects"
            size="md"
            borderWidth={2}
            metalConfig={{ speed: 0.6, distortion: 0.2, colorTint: "#ffffff" }}
          >
            View Projects
          </LiquidMetalButton>

          <LiquidMetalButton
            client:load
            href="#contact"
            size="md"
            borderWidth={2}
            metalConfig={{ speed: 0.5, distortion: 0.18, colorTint: "#ffffff" }}
          >
            Get in Touch
          </LiquidMetalButton>
        </div>
      </div>
    </section>

    <Skills />
    <Projects />
    <Resume />
  </main>

  <Footer />
  <AISearchModal client:idle />
</BaseLayout>
